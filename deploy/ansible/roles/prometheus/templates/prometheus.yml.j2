global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: node_exporter
    static_configs:
      - targets:
          - "{{ app_server_ip }}:9100"

  - job_name: postgres_exporter
    static_configs:
      - targets:
          - "{{ app_server_ip }}:9187"

  - job_name: redis_exporter
    static_configs:
      - targets:
          - "{{ app_server_ip }}:9121"

  - job_name: nginx_exporter
    static_configs:
      - targets:
          - "{{ app_server_ip }}:9113"
