APP_NAME="{{ env_app_name }}"
APP_ENV=local
APP_KEY="{{ env_app_key }}"
APP_DEBUG={{ env_app_debug | lower }}
APP_URL=https://{{ domain_name }}

APP_TIMEZONE=Europe/Berlin
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12
APP_FORCE_HTTPS=true
APP_EVENT_TYPE="{{ env_app_event_type }}"

PUBLIC_API_SECRET="{{ env_app_public_api_secret }}"

TUTOR_PASSWORD="{{ env_app_tutor_password }}"
ADMIN_PASSWORD="{{ env_app_admin_password }}"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE="{{ db_name }}"
DB_USERNAME="{{ db_user }}"
DB_PASSWORD="{{ db_password }}"

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD="{{ redis_password }}"

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID="{{ s3_access_key }}"
AWS_SECRET_ACCESS_KEY="{{ s3_secret_key }}"
AWS_DEFAULT_REGION="{{ s3_region }}"
AWS_BUCKET="{{ s3_bucket }}"
AWS_ENDPOINT="{{ s3_endpoint }}"
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

OCTANE_HTTPS=false
OCTANE_WORKERS={{ octane_workers }}
OCTANE_MAX_REQUESTS={{ octane_max_requests }}
OCTANE_SERVER=swoole

DIVISION_DEBUG_LOG=
